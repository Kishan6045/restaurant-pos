## Backend (required)
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too

## Backend (optional)
LOG_ENABLED=false

## Cloudinary (optional; only if using uploads)
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

## Frontend (optional)
# If deploying frontend separately (not via included Nginx proxy),
# set an absolute backend URL, e.g. https://api.example.com
VITE_API_URL=
