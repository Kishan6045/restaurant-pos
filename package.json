{
  "name": "restaurant-pos",
  "private": true,
  "scripts": {
    "backend:mongo": "cd backend && npm run dev",
    "backend:sql": "cd backend-mysql && npm run dev",

    "frontend": "cd frontend && npm run dev",

    "dev:mongo": "concurrently \"npm run backend:mongo\" \"npm run frontend\"",
    "dev:sql": "concurrently \"npm run backend:sql\" \"npm run frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "rxjs": "^7.8.1"
  }
}
